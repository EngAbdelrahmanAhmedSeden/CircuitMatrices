<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@ViewData["Title"] - Circuit Graph Analyzer</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Ccircle cx=%278%27 cy=%2716%27 r=%274%27 fill=%27%231f5fd1%27/%3E%3Ccircle cx=%2724%27 cy=%278%27 r=%274%27 fill=%27%231f5fd1%27/%3E%3Ccircle cx=%2724%27 cy=%2724%27 r=%274%27 fill=%27%231f5fd1%27/%3E%3Cpath d=%27M8 16L24 8M8 16L24 24M24 8V24%27 stroke=%27%231f5fd1%27 stroke-width=%272%27 fill=%27none%27/%3E%3C/svg%3E">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>

<header class="top no-print">
  <div class="wrap">
    <div>
      <h1>Circuit Graph Analyzer</h1>
      <p class="sub">Computer Aided Design (CAD) &middot; Network topology matrices and equilibrium equations</p>
    </div>
    <nav class="nav" aria-label="Main">
      <a asp-controller="Home" asp-action="Index">Analyzer</a>
      <a asp-controller="Home" asp-action="Theory">Theory &amp; exam notes</a>
    </nav>
  </div>
</header>

<main class="wrap">
  @RenderBody()
</main>

<footer class="wrap muted no-print">Built from CAD Lectures 1&ndash;3. Results are checked automatically with KCL, KVL and Tellegen&rsquo;s theorem.</footer>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
